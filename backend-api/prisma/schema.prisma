generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Cliente (negocio) al que se le vende el servicio. Todos sus datos cuelgan de aquí.
model Business {
  id             String   @id @default(uuid())
  name           String
  active         Boolean  @default(true)
  maxScreens     Int      @default(3)
  storageLimitMb Int      @default(1024)
  user           User?
  screens        Screen[]
  playlists      Playlist[]
  media          Media[]
  priceLists     PriceList[]
  products       Product[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         String    @default("business") // superadmin | business
  businessId   String?   @unique // un solo usuario por negocio
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Screen {
  id            String    @id @default(uuid())
  name          String
  location      String?
  status        String    @default("offline") // pending, online, offline
  pairingCode   String?   @unique
  businessId    String? // null mientras la pantalla está sin vincular
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tokenHash     String? // SHA-256 del token que usa la TV para sincronizar
  pairingToken  String? // token en claro solo hasta el primer sync (la TV lo recibe al vincularse)
  playlist      Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  playlistId    String?
  layout        String    @default("split") // split, full-media, full-menu
  transition    String    @default("fade") // fade, slide, zoom
  mediaDuration Int       @default(10) // duration in seconds per image
  lastSeenAt    DateTime? // último sync del reproductor
  playerVersion String? // versión del reproductor que informa la TV (ej. "2026-10-09 21:01 UTC [ota]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Playlist {
  id         String         @id @default(uuid())
  name       String
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      PlaylistItem[]
  screens    Screen[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model PlaylistItem {
  id          String     @id @default(uuid())
  playlistId  String
  playlist    Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaId     String?
  media       Media?     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  duration    Int        @default(10) // duration in seconds
  order       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Media {
  id         String         @id @default(uuid())
  name       String
  type       String // image, video
  url        String // /uploads/<businessId>/<archivo>
  size       Int? // bytes
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      PlaylistItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model PriceList {
  id            String         @id @default(uuid())
  name          String
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items         PriceItem[]
  playlistItems PlaylistItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PriceItem {
  id          String    @id @default(uuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productName String
  description String?
  price       Float
  order       Int       @default(0)
}

model Product {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  internalCode String?
  barcode      String?
  name         String
  description  String?
  price        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, internalCode])
  @@unique([businessId, barcode])
}
