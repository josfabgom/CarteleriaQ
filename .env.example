# Copiar a .env (docker compose lo lee automáticamente)
POSTGRES_USER=carteleria_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=carteleria_db
# URL pública del backend tal como la ve el navegador que abre el dashboard
VITE_API_URL=http://localhost:3000

# Seguridad: secreto para firmar sesiones (generar con: openssl rand -hex 32)
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
# Administrador inicial (se crea solo la primera vez que arranca el backend)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_esta_clave_de_admin
# Opcional: orígenes permitidos para la API, separados por coma (vacío = cualquiera)
CORS_ORIGIN=
