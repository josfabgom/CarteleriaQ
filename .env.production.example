# Copiar a .env en el VPS y completar. NO subir .env a git.

# Dominio que apunta a la IP del VPS (registro DNS tipo A), sin https://
DOMAIN=carteleria.tudominio.com

POSTGRES_USER=carteleria_user
POSTGRES_PASSWORD=generar_con_openssl_rand_-hex_16
POSTGRES_DB=carteleria_db

# Secreto para firmar sesiones: openssl rand -hex 32
JWT_SECRET=generar_con_openssl_rand_-hex_32

# Administrador inicial (se crea la primera vez que arranca el backend)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=una_clave_larga_y_unica

# Dejar vacío: las TVs (app Android) llaman a la API desde otro origen
CORS_ORIGIN=
